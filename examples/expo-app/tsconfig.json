{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Typecheck only: the kit ships TS source and has its own node_modules (react + @types/react for
    // its unit tests). Point react / react-native at THIS app's copies so there is one set of types.
    // (Metro does not read these: app.json sets experiments.tsconfigPaths = false; metro.config.js
    // handles runtime resolution.)
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-native": ["./node_modules/react-native"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist-check", "android", "ios"]
}
